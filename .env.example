# Deriv Bot Configuration

# Trading Mode: paper or live
TRADING_MODE=paper

# Deriv API Settings
DERIV_APP_ID=your_app_id_here
DERIV_API_TOKEN=your_api_token_here
DERIV_CURRENCY=USD

# Bot Configuration Files
STRATEGY_FILE=./config/strategy.xml
STATE_FILE=./state/bot-state.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
